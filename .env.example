# Supabase (Project Settings → API in the Supabase dashboard).
# Copy this file to .env.local and fill in the values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or, on older projects, the anon key.
# Never put a secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never NEXT_PUBLIC_): the secret key (sb_secret_…, or the older
# service_role key). The app server uses it to store round scores, which
# players can't write. Without it, games still run and every round scores 0.
# SUPABASE_SECRET_KEY=
